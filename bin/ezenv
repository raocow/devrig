#!/usr/bin/env bash
# ezenv — opt-in shell environment helpers.
set -eo pipefail

VERSION="0.1.1"

# Resolve this script's real location (following symlinks), then the keg/repo
# root (bin/..), so `share/ezenv` is found whether run from Homebrew or source.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
BIN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
SHARE="$(cd "$BIN_DIR/.." && pwd)/share/ezenv"

RC="${EZENV_RC:-${ZDOTDIR:-$HOME}/.zshrc}"

usage() {
  cat <<EOF
ezenv $VERSION — opt-in shell environment helpers

Usage:
  ezenv install [feature...]     Enable feature(s) by adding them to your ~/.zshrc
  ezenv uninstall [feature...]   Disable feature(s) by removing them from ~/.zshrc
  ezenv status                   Show which features are enabled
  ezenv doctor                   Show current environment (python/pip/venv)
  ezenv init [feature...]        Print the raw source line(s) — for eval or manual use
  ezenv version                  Print version
  ezenv help                     Show this help

Features:
  autovenv       Auto-activate the nearest .venv when you cd into a repo
  py-fallback    Make bare 'python'/'pip' resolve to python3/pip3
  all            Everything (default when no feature is given)

Example:
  ezenv install autovenv     # then: exec zsh
EOF
}

# Stable share dir for lines written into the rc file: prefer the version-independent
# Homebrew opt path; fall back to the resolved location for source/dev runs.
share_dir() {
  local p
  if p="$(brew --prefix ezenv 2>/dev/null)" && [ -d "$p/share/ezenv" ]; then
    echo "$p/share/ezenv"
  else
    echo "$SHARE"
  fi
}

feature_file() {
  case "$1" in
    autovenv)    echo "autovenv.zsh" ;;
    py-fallback) echo "py-fallback.zsh" ;;
    *)           return 1 ;;
  esac
}

# Echo the requested features, expanding 'all' and defaulting to all when empty.
expand_features() {
  if [ "$#" -eq 0 ]; then echo "autovenv py-fallback"; return; fi
  local f out=""
  for f in "$@"; do
    if [ "$f" = all ]; then out="$out autovenv py-fallback"; else out="$out $f"; fi
  done
  echo "$out"
}

cmd_install() {
  local sd; sd="$(share_dir)"
  touch "$RC"
  local changed=0 f file marker
  for f in $(expand_features "$@"); do
    if ! file="$(feature_file "$f")"; then
      echo "ezenv: unknown feature '$f' (try: autovenv, py-fallback, all)" >&2; continue
    fi
    marker="# ezenv:$f"
    if grep -qF "$marker" "$RC"; then
      echo "already enabled: $f"
      continue
    fi
    printf 'source "%s/%s"  %s\n' "$sd" "$file" "$marker" >> "$RC"
    echo "enabled: $f"
    changed=1
  done
  [ "$changed" = 1 ] && echo "Restart your shell to apply:  exec zsh"
  return 0
}

cmd_uninstall() {
  [ -f "$RC" ] || { echo "nothing to do (no $RC)"; return 0; }
  local changed=0 f marker tmp
  for f in $(expand_features "$@"); do
    marker="# ezenv:$f"
    if grep -qF "$marker" "$RC"; then
      tmp="$(mktemp "${RC}.ezenv.XXXXXX")"
      grep -vF "$marker" "$RC" > "$tmp" && mv "$tmp" "$RC"
      echo "disabled: $f"
      changed=1
    else
      echo "not enabled: $f"
    fi
  done
  [ "$changed" = 1 ] && echo "Restart your shell to apply:  exec zsh"
  return 0
}

cmd_status() {
  echo "rc file : $RC"
  local f marker
  for f in autovenv py-fallback; do
    marker="# ezenv:$f"
    if [ -f "$RC" ] && grep -qF "$marker" "$RC"; then
      echo "  $f : enabled"
    else
      echo "  $f : disabled"
    fi
  done
}

cmd_doctor() {
  echo "ezenv $VERSION"
  echo "share dir   : $(share_dir)"
  echo "python      : $(command -v python || echo '<not found>')"
  echo "python3     : $(command -v python3 || echo '<not found>')"
  echo "pip         : $(command -v pip || echo '<not found>')"
  echo "pip3        : $(command -v pip3 || echo '<not found>')"
  echo "VIRTUAL_ENV : ${VIRTUAL_ENV:-<none>}"
}

cmd_init() {
  local sd; sd="$(share_dir)"
  local f file
  for f in $(expand_features "$@"); do
    if ! file="$(feature_file "$f")"; then
      echo "ezenv: unknown feature '$f' (try: autovenv, py-fallback, all)" >&2; return 1
    fi
    printf 'source "%s/%s"\n' "$sd" "$file"
  done
}

case "${1:-help}" in
  install)              shift; cmd_install "$@" ;;
  uninstall|remove)     shift; cmd_uninstall "$@" ;;
  status)               cmd_status ;;
  doctor)               cmd_doctor ;;
  init)                 shift; cmd_init "$@" ;;
  version|--version|-v) echo "ezenv $VERSION" ;;
  help|--help|-h)       usage ;;
  *)                    usage >&2; exit 1 ;;
esac
